# SANGVAIL Environment Configuration
# Copy this file to .env and customize for your local environment.
# NEVER commit .env or real credentials to version control.

# Database URL
# Default: local SQLite fallback (works out of the box without PostgreSQL)
DATABASE_URL=sqlite:///data/sangvail.db

# PostgreSQL Example (uncomment and fill in local credentials to use PostgreSQL):
# DATABASE_URL=postgresql+psycopg://sangvail_user:CHANGE_ME@localhost:5432/sangvail

# Application Metadata
APP_NAME=SANGVAIL
APP_ENV=development
DEFAULT_TIMEZONE=UTC

# Default Local Administrator Account (CHANGE BEFORE SHARED DEPLOYMENT)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Synthetic Data Generator Seed
SYNTHETIC_DATA_SEED=42
